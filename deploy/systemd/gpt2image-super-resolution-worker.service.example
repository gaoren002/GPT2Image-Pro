[Unit]
Description=GPT2Image isolated ONNX image worker
After=network.target

[Service]
Type=simple
# Point this at apps/web inside the active Next standalone release.
WorkingDirectory=/opt/gpt2image/current/apps/web/.next/standalone/apps/web
EnvironmentFile=/opt/gpt2image/shared/.env.local
Environment=NODE_ENV=production
Environment=SUPER_RESOLUTION_WORKER_BIND=127.0.0.1
Environment=SUPER_RESOLUTION_WORKER_PORT=3310
Environment=SUPER_RESOLUTION_WORKER_CONCURRENCY=1
Environment=SUPER_RESOLUTION_WORKER_MAX_QUEUE=2
Environment=SUPER_RESOLUTION_WORKER_MAX_BODY_MB=32
Environment=SUPER_RESOLUTION_WORKER_TIMEOUT_MS=300000
Environment=SUPER_RESOLUTION_INTRA_OP_THREADS=24
Environment=SUPER_RESOLUTION_SHARP_CONCURRENCY=2
Environment=UV_THREADPOOL_SIZE=4
ExecStart=/usr/bin/node worker/super-resolution-worker.mjs
Restart=on-failure
RestartSec=2

# Keep inference from starving page rendering on the same host.
Nice=10
CPUAccounting=true
CPUQuota=2400%
# 示例预算必须与宿主机及 Web 的内存余量一同验收；不是本机推理通过声明。
# native ONNX 内存不受 V8 heap 限额约束，必须由独立 cgroup 执行硬限制。
MemoryAccounting=true
MemoryMax=6G
MemorySwapMax=0
OOMPolicy=kill
KillMode=control-group

[Install]
WantedBy=multi-user.target
